# Used when Docker Hub anonymous metadata fetches hang. Bases on the existing
# chompy:latest image (which already has Ubuntu 22.04 + Z3 4.12.1 + Rust +
# apt deps + cargo target cache from a prior build) and only refreshes source
# and rebuilds the cargo binary. Run via:
#
#     docker build -t chompy:latest -f Dockerfile.update .
#
# Once Docker Hub is responsive again, prefer the canonical Dockerfile
# (which builds from scratch and is what reviewers will use).
FROM chompy:latest

# Replace just the chompy source tree, preserving the existing /chompy/target
# cache so cargo can do an incremental rebuild. .dockerignore excludes
# target/, eval/, eval-docker/, llm_cached/, mini-artifacts/, .cargo/, *.log
# so they're not part of the COPY context.
COPY . /tmp/chompy-src/
RUN cp -R /tmp/chompy-src/. /chompy/ \
    && rm -rf /tmp/chompy-src \
    && cd /chompy && cargo build --release

CMD ["python3", "python/run_the_eval.py"]
