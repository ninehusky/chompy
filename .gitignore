# Top level
/target
/out
/*.json
/*.sh
/nightly
/*.terms
/*.rules

# Scripts
scripts/ablation/output/*
scripts/eqsat-sound/output/*
scripts/herbie-float/output/*
scripts/herbie-rational/output/*

# Rust
Cargo.lock

# Mac
.DS_Store

# Miscellaneous
out/
.vscode/
*.txt
*.pdf
*.bak
.z3-trace

# Racket
*.dep
*.zo

# Exceptions
!scripts/oopsla21/ablation/submitted-plots/**/*.pdf
!scripts/oopsla21/ablation/submitted-plots/**/*.json

# Don't want flamegraphs.
flamegraph.svg

# We don't want logs.
*.log
*.smt2

# We don't want venv artifacts.
python/bin
python/include
python/lib
python/pyvenv.cfg

# FMCAD-2026 artifact exceptions: rulesets (.txt) and synthesis logs (.log)
# under eval-docker/ and eval-archive/ ARE the artifact and must be tracked.
# Placed at end so these exceptions override the broad *.txt and *.log rules
# above (later rules win in gitignore).
!eval-docker/**/*.txt
!eval-docker/**/*.log
!eval-archive/**/*.txt
!eval-archive/**/*.log
